rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'fiel';
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && (
          (!('email' in request.resource.data) && !('email' in resource.data))
          || request.resource.data.email == resource.data.email
        );
      allow delete: if false;

      // Avise-me. O fiel marca e apaga só o próprio lembrete, e o documento
      // não tem campo livre: só o id do item e a data da marcação.
      match /lembretes/{itemId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['itemId', 'createdAt'])
          && request.resource.data.itemId == itemId
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /news/{newsId} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /programItems/{itemId} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /deviceTokens/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() < 400;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // lembreteAvisos não tem match de propósito. O cliente não lê nem
    // escreve os avisos que já saíram. O job usa o Admin SDK.

    match /benefactorLeads/{leadId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lgpdConsent == true
        && request.resource.data.status == 'novo';
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Testemunhos. O fiel não lê a coleção: o texto só é lido pela equipe, e a
    // leitura é integral, sem resumo no meio. A escrita é false de propósito:
    // quem grava é o Route Handler app/api/testemunhos, com o Admin SDK e a
    // service account. As rules não valem para o Admin SDK, então ele é a
    // única via de escrita.
    match /testimonials/{testimonialId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
