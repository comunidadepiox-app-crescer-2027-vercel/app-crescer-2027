rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function origemOk() {
      return !('origem' in request.resource.data)
        || request.resource.data.origem == null
        || (
          request.resource.data.origem.keys().hasOnly(['lat', 'lng', 'updatedAt'])
          && request.resource.data.origem.lat is number
          && request.resource.data.origem.lng is number
          && request.resource.data.origem.lat >= -90
          && request.resource.data.origem.lat <= 90
          && request.resource.data.origem.lng >= -180
          && request.resource.data.origem.lng <= 180
          && request.resource.data.origem.updatedAt is timestamp
        );
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'fiel';
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && (
          (!('email' in request.resource.data) && !('email' in resource.data))
          || request.resource.data.email == resource.data.email
        )
        && origemOk();
      allow delete: if false;

      match /queroIr/{itemId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['itemId', 'createdAt'])
          && request.resource.data.itemId == itemId
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /news/{newsId} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /programItems/{itemId} {
      allow read: if signedIn() && (resource.data.published == true || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /siteContent/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /deviceTokens/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() < 400;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // trafficAlerts e mapsUsage não têm match de propósito.
    // O cliente não lê nem escreve. O job usa o Admin SDK.

    match /benefactorLeads/{leadId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lgpdConsent == true
        && request.resource.data.status == 'novo';
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Testemunhos. O fiel não lê a coleção, porque o texto ainda não foi
    // aprovado pela equipe. A escrita é false de propósito: quem grava é o
    // Route Handler app/api/testemunhos, com o Admin SDK e a service account,
    // depois de passar o texto pelo filtro da IA. As rules não valem para o
    // Admin SDK, então ele é a única via de escrita.
    match /testimonials/{testimonialId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
