# Copie para .env.local e preencha. Nunca versionar este arquivo com valores reais.
# O .env e o .env.local já estão no .gitignore.

# Firebase: chaves públicas do client (NEXT_PUBLIC_*)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Somente no servidor (upload assinado no Route Handler). Nunca no client.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Service account do Firebase, em JSON de uma linha só, entre aspas simples.
# Usada pelo Admin SDK em app/api/testemunhos, em app/api/lead-benfeitor e pelo
# job de avisos da programação. É o mesmo secret cadastrado no GitHub, em
# FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT=''

# E-mail do cadastro de Benfeitor da Fé para a comissão. Só no servidor, nunca
# no bundle do app. Sem RESEND_API_KEY ou sem destino, o lead continua gravado
# em benefactorLeads e aparece em /admin/leads, e a tela não promete e-mail.
# Chave da conta Resend, em https://resend.com/api-keys.
RESEND_API_KEY=
# Endereço da comissão. A constante DESTINO em lib/server/emailBenfeitor.js é o
# lugar oficial e esta variável sobrescreve sem novo deploy.
EMAIL_BENFEITOR_DESTINO=
# Remetente verificado na Resend. Sem valor, a rota usa
# Crescer <onboarding@resend.dev>.
EMAIL_BENFEITOR_REMETENTE=

# Não existe mais nenhuma chave externa.
# A IA do testemunho saiu em 28/09/2026, e o aviso da programação não usa
# serviço de mapa nem chave de trânsito.
