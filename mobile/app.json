{
  "expo": {
    "name": "Crescer",
    "slug": "crescer",
    "version": "1.0.0",
    "scheme": "crescer",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#3e1c7a",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.org.piox.crescer",
      "infoPlist": {
        "NSCameraUsageDescription": "Permite tirar a foto ou o documento exigido nos formulários de inscrição do Crescer 2027.",
        "NSPhotoLibraryUsageDescription": "Permite escolher a foto ou o arquivo exigido nos formulários de inscrição do Crescer 2027."
      }
    },
    "android": {
      "package": "br.org.piox.crescer",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#3a1075",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3e1c7a",
          "image": "./assets/brand/simbolo-crescer.png",
          "imageWidth": 160
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3a1075"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aad5dd2a-5839-4ac9-af91-c35d783db3b5"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/aad5dd2a-5839-4ac9-af91-c35d783db3b5"
    },
    "owner": "comunidade-sao-pio-x-cge"
  }
}
