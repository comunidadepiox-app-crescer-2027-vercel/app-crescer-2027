        <mxCell id="fbRules" value="Regras de acesso&#xa;Admin: conteúdo e moderação&#xa;App: sessão própria, token e lembretes&#xa;APIs usam Admin SDK para gravações protegidas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="firebaseLane"><mxGeometry x="30" y="520" width="220" height="110" as="geometry"/></mxCell>
