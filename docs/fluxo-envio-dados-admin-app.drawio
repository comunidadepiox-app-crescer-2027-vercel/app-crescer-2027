        <mxCell id="appSession" value="Sessão anônima&#xa;Firebase Auth retorna uid&#xa;Cria users/{uid} com role=fiel se faltar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="appLane"><mxGeometry x="35" y="65" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="appRead" value="App consulta conteúdo&#xa;Notícias, cronograma&#xa;Destaques e doação&#xa;Exibe dados publicados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="appLane"><mxGeometry x="255" y="70" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="appTestimonial" value="Testemunho&#xa;POST /api/testemunhos + token&#xa;Texto 20–2000 caracteres; nome ou anônimo&#xa;Uma submissão por uid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="appLane"><mxGeometry x="35" y="210" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="appLead" value="Benfeitor da Fé&#xa;POST /api/lead-benfeitor + token&#xa;Consentimento LGPD e validação de nome, e-mail, celular e CPF&#xa;Uma submissão por uid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="appLane"><mxGeometry x="255" y="210" width="200" height="125" as="geometry"/></mxCell>
