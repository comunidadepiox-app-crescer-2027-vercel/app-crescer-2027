        <mxCell id="webUploads" value="Upload pelo painel&#xa;Imagem até 8 MB; vídeo até 80 MB&#xa;Admin envia ID token e arquivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="webLane"><mxGeometry x="255" y="205" width="200" height="80" as="geometry"/></mxCell>
