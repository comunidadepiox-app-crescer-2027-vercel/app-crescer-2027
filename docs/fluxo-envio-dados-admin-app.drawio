        <mxCell id="resend" value="RESEND&#xa;E-mail à comissão sobre novo lead&#xa;Falha no envio não apaga o cadastro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="appLane"><mxGeometry x="35" y="550" width="200" height="85" as="geometry"/></mxCell>
