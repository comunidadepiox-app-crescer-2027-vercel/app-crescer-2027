        <mxCell id="cloudinary" value="CLOUDINARY&#xa;Guarda mídia&#xa;URL segura retorna ao painel&#xa;URL é gravada em news" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="webLane"><mxGeometry x="255" y="475" width="200" height="95" as="geometry"/></mxCell>
        <mxCell id="webModerate" value="Mesa de testemunhos&#xa;Lê pasta aguardando&#xa;Equipe marca lido ou não aceito&#xa;Atualiza pasta, status e auditoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="webLane"><mxGeometry x="35" y="350" width="200" height="105" as="geometry"/></mxCell>
        <mxCell id="webLeads" value="Mesa de benfeitores&#xa;Lê cadastros recebidos&#xa;Equipe atualiza status: novo, contatado, descartado&#xa;WhatsApp abre conversa externa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="webLane"><mxGeometry x="35" y="505" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="webNotify" value="Cronograma publicado de hoje muda&#xa;Painel chama POST /api/notify-programa&#xa;Envia token e data do recorte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="webLane"><mxGeometry x="35" y="665" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="apiNotify" value="API valida admin e data&#xa;Lê deviceTokens&#xa;Envia lotes de até 100 ao Expo Push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="webLane"><mxGeometry x="255" y="675" width="200" height="90" as="geometry"/></mxCell>

